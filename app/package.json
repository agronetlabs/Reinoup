{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun install --frozen-lockfile && tsc -b && vite build",
    "build:fast": "tsc -b && vite build",
    "lint": "oxlint",
    "check:conteudo": "bun scripts/check-content.ts",
    "assets:stories": "bun scripts/build-story-assets.mjs",
    "assets:brand": "bun scripts/build-brand-assets.mjs",
    "audio:stories": "bun scripts/generate-story-audio.mjs",
    "test:payments": "bun test tests/payments.test.ts",
    "test:app": "bun test tests/story-audio.test.ts tests/gameplay.test.ts tests/gameplay-progress.test.ts tests/activity-report.test.ts tests/brand-assets.test.ts",
    "test:stripe:sandbox": "bun scripts/test-stripe-sandbox.ts",
    "check:payments": "tsc -p tsconfig.functions.json && bun run test:payments",
    "check": "bun run lint && bun run check:conteudo && bun run check:payments && bun run test:app && bun run build:fast",
    "preview": "vite preview"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.24.0",
    "@elevenlabs/react": "^1.15.1",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
